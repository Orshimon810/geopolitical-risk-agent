# =============================================================================
# Core LLM
# =============================================================================
OPENAI_API_KEY=your_openai_key_here
MODEL_NAME=gpt-4o-mini

# =============================================================================
# PostgreSQL / pgvector  (Step 1)
# =============================================================================
# Neon format:  postgresql+asyncpg://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# Local format: postgresql+asyncpg://postgres:postgres@localhost:5432/georisk
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?sslmode=require

# =============================================================================
# JWT Authentication  (Step 2)
# =============================================================================
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# Redis  (Step 2)
# =============================================================================
# Local:  redis://localhost:6379/0
# Cloud:  redis://:<password>@<host>:6380/0  (e.g. Redis Cloud, Upstash)
REDIS_URL=redis://localhost:6379/0

# Requests allowed per user per hour before HTTP 429 is returned
RATE_LIMIT_PER_HOUR=5

# =============================================================================
# Celery task queue  (Step 2)
# =============================================================================
# Broker options:
#   Redis (dev default):  redis://localhost:6379/1
#   RabbitMQ:             amqp://user:pass@host:5672//
#   AWS SQS:              sqs://aws_access_key:aws_secret_key@
BROKER_URL=redis://localhost:6379/1

# Celery result backend (stores task metadata — keep as Redis):
RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# App behaviour
# =============================================================================
# Set to "prod" in production: disables Swagger UI and enables startup validation
APP_ENV=dev
