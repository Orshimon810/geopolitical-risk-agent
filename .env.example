# =============================================================================
# Core LLM
# =============================================================================
OPENAI_API_KEY=your_openai_key_here
MODEL_NAME=gpt-4o-mini

# =============================================================================
# PostgreSQL / pgvector  (Step 1)
# =============================================================================
# Neon format:  postgresql+asyncpg://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
# Local format: postgresql+asyncpg://postgres:postgres@localhost:5432/georisk
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?sslmode=require

# =============================================================================
# JWT Authentication  (Step 2)
# =============================================================================
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Long-lived refresh token stored as httpOnly cookie. Rotation happens on every
# successful refresh so the effective session length resets with each use.
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Redis  (Step 2)
# =============================================================================
# Local:  redis://localhost:6379/0
# Cloud:  redis://:<password>@<host>:6380/0  (e.g. Redis Cloud, Upstash)
REDIS_URL=redis://localhost:6379/0

# Requests allowed per user per hour before HTTP 429 is returned
RATE_LIMIT_PER_HOUR=5

# =============================================================================
# Celery task queue  (Step 2)
# =============================================================================
# Broker options:
#   Redis (dev default):  redis://localhost:6379/1
#   RabbitMQ:             amqp://user:pass@host:5672//
#   AWS SQS:              sqs://aws_access_key:aws_secret_key@
BROKER_URL=redis://localhost:6379/1

# Celery result backend (stores task metadata — keep as Redis):
RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# App behaviour
# =============================================================================
# Set to "prod" in production: disables Swagger UI and enables startup validation
APP_ENV=dev

# =============================================================================
# Query result cache
# =============================================================================
# How long (seconds) a query result is cached in Redis before the next identical
# query triggers a fresh pipeline run. Default: 7200 (2 hours).
QUERY_CACHE_TTL=7200

# =============================================================================
# Email — password reset (via Resend — https://resend.com, free tier available)
# =============================================================================
# Leave RESEND_API_KEY empty (default) to use dev mode: reset links are logged
# to stdout instead of sent. Cloud SMTP (port 587) is blocked by most providers.
RESEND_API_KEY=

# "From" address shown in the email. Must be a verified domain in Resend,
# or use "onboarding@resend.dev" for testing on the free tier.
SMTP_FROM=onboarding@resend.dev

# Base URL of the frontend — used to build the reset link in the email.
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Ephemeral live-news cache
# =============================================================================
# Provider: "newsapi" (newsapi.org, free tier: 100 req/day) or
#           "finnhub" (finnhub.io, free tier: 60 req/min)
NEWS_PROVIDER=newsapi

# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=

# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=

# How long (hours) a news article is kept in ephemeral_embeddings before expiry.
# Default 48h — covers a full news cycle while keeping the table lean.
EPHEMERAL_TTL_HOURS=48

# =============================================================================
# Dynamic pipeline — Reviewer loop + HITL
# =============================================================================
# Max Reviewer retry cycles per analysis (0 = reviewer runs but never retries).
# Each retry adds ~1 extra RAG + Analysis + Reviewer call. Default: 1.
MAX_RETRIES=1

# Redis URL for LangGraph graph checkpoints.
# Defaults to REDIS_URL (DB 0) when not set — safe for single-DB providers
# (Upstash free tier). RedisSaver uses "checkpoint:" key prefixes that don't
# collide with task state, rate-limit, or Celery keys.
# Only set this if you have a multi-DB Redis and want strict isolation.
# LANGGRAPH_REDIS_URL=redis://localhost:6379/0

# Minutes a task can sit in WAITING_FOR_INPUT before the original plan is
# auto-approved. Prevents stuck sessions when the user closes the browser.
HITL_TIMEOUT_MINUTES=10
